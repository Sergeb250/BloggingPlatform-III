{
  "info": {
    "name": "Blogging Platform API",
    "description": "All endpoints of the Blogging Platform (Spring Boot + Spring Data JPA).\n\nRun the folders top to bottom (or the whole collection with the Collection Runner): each request saves the ids it creates (userId, postId, ...) in collection variables for the next ones.\n\nEvery response has the shape { success, status, message, data | errors, timestamp }.\nStart the app first (mvnw spring-boot:run) and set baseUrl if it is not http://localhost:8080.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "username",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "tagId",
      "value": ""
    },
    {
      "key": "postId",
      "value": ""
    },
    {
      "key": "postVersion",
      "value": "0"
    },
    {
      "key": "nextCursor",
      "value": ""
    },
    {
      "key": "commentId",
      "value": ""
    },
    {
      "key": "commentVersion",
      "value": "0"
    },
    {
      "key": "reviewId",
      "value": ""
    }
  ],
