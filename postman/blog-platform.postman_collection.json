      "name": "1. Users",
      "item": [
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"postman_{{$timestamp}}\",\n  \"email\": \"postman_{{$timestamp}}@blog.com\",\n  \"password\": \"secret123\",\n  \"role\": \"AUTHOR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"success is true\", () => pm.expect(pm.response.json().success).to.eql(true));",
                  "const user = pm.response.json().data;",
                  "pm.collectionVariables.set(\"userId\", user.id);",
                  "pm.collectionVariables.set(\"username\", user.username);"
                ]
              }
            }
          ]
        },
